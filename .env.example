# ---------------------------------------------------------------------------
# Lokaal draaien: dit bestand kopieren naar .env en invullen.
# Live op Vercel: dezelfde namen invoeren onder Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Database. Leeg laten = lokaal bestand (data/leads.db).
# Live: de connection string van Supabase (Session pooler, poort 5432).
DATABASE_URL=

# Wachtwoord voor het dashboard. VERPLICHT zodra het online staat:
# zonder dit blijft het dashboard dicht.
DASHBOARD_PASSWORD=

# Ondertekent de inlogsessie. Een lange willekeurige tekst.
# Wijzig je hem, dan moet iedereen opnieuw inloggen.
SESSION_SECRET=

# Vast token voor de knoppen in het dashboard. Zonder dit krijgt elke
# serverless instantie een eigen token en werken de knoppen onbetrouwbaar.
DASHBOARD_TOKEN=

# Beschermt het cron-eindpunt. Zonder dit weigert /api/cron elk verzoek.
CRON_SECRET=

# De basis-URL van je project. Hiermee worden de links naar de demopagina's
# opgebouwd die in je mails komen te staan.
PUBLIC_BASE_URL=https://jouwproject.vercel.app

# Mail versturen via Resend (aanrader; werkt wel vanuit serverless).
# Het afzenderdomein moet in Resend geverifieerd zijn.
RESEND_API_KEY=

# Alternatief: je eigen SMTP-server. Alleen zinvol als je lokaal draait.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ---------------------------------------------------------------------------
# Instellingen die anders in config/campaign.yaml staan. Handig om ze live
# aan te passen zonder opnieuw uit te rollen.
# ---------------------------------------------------------------------------
LM_AREA=
LM_SENDER_NAME=
LM_SENDER_EMAIL=
LM_COMPANY_NAME=
LM_COMPANY_ADDRESS=
LM_KVK=
LM_PHONE=
LM_REPLY_TO=
LM_DAILY_LIMIT=25

# Autopilot. enabled=true betekent: er wordt echt gemaild.
LM_ENABLED=false
LM_SEND_MODE=review
LM_REVIEW_HOURS=12
LM_MAILS_PER_RUN=20
LM_MIN_SCORE=45
LM_SOURCE=overpass
