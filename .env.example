# SMTP voor het daadwerkelijk versturen van outreach.
# Gebruik een mailbox op je eigen domein (niet je persoonlijke Gmail):
# betere deliverability en je kunt SPF/DKIM/DMARC goed zetten.
SMTP_HOST=smtp.jouwprovider.nl
SMTP_PORT=587
SMTP_USER=hallo@jouwbedrijf.nl
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Waar demo-sites komen te staan (gebruikt in de mailtekst).
# Bijv. GitHub Pages, Netlify of Cloudflare Pages.
DEMO_BASE_URL=https://demos.jouwbedrijf.nl
